# Copy this file to ~/.config/youtube/.env and replace placeholders locally.
# Keep the local file mode 600. Never commit real credentials.

# DataImpulse is preferred when both providers are configured.
DATAIMPULSE_USER=your-dataimpulse-login
DATAIMPULSE_PASSWORD=your-dataimpulse-password
DATAIMPULSE_ENDPOINT=gw.dataimpulse.com:823

# Alternatively, replace DATAIMPULSE_ENDPOINT with these two settings:
# DATAIMPULSE_HOST=gw.dataimpulse.com
# DATAIMPULSE_PORT=823

# Oxylabs remains available as a fallback when DataImpulse is not configured.
# OXYLABS_USER=your-oxylabs-user
# OXYLABS_ENDPOINT=your-oxylabs-endpoint
# OXYLABS_PASSWORD=your-oxylabs-password
